use std::str::FromStr;
use crate::{
    ast::{
        Block, DeviceStatement, Statement, Identifier, IfStatement, Program, Value, Expr, BinaryOpcode, UnaryOpcode,
    },
    utils::append,
};

grammar;

// Customize the lexer: skip whitespace/comments, and give device refs
// (d0-d5, db) higher priority than identifiers so that "dest_code" parses
// as an identifier but "d0" parses as a device reference.
match {
    r"\s*" => {},                                     // skip whitespace
    r"//[^\n\r]*[\n\r]*" => {},                       // skip // line comments
    r"/\*[^*]*\*+(?:[^/*][^*]*\*+)*/" => {},          // skip /* block comments */
    r"d[0-5b]",                                        // device refs: highest priority
} else {
    _                                                  // everything else (identifiers, etc.)
}

pub Program: Program = <Statements> => Program::new(<>);

Statements: Vec<Statement> = {
    Statement => vec![<>],
    Statements Statement => append(<>),
};

Statement: Statement = {
    "let" <Identifier> "=" <Expr> ";" => Statement::new_definition(<>),
    "def" <Device> "as" <Identifier> ";" => Statement::new_alias(<>),
    <Block> => Statement::new_block(<>),
    "fn" <Identifier> "(" <Params> ")" <Block> => Statement::new_function(<>),
    <Identifier> "(" <Args> ")" ";" => Statement::new_function_call(<>),
    <Identifier> "=" <Expr> ";" => Statement::new_assignment(<>),
    "loop" <Block> => Statement::new_loop(<>),
    <IfStatement> => Statement::new_if(<>),
    <DeviceStatement> ";" => Statement::new_device(<>),
    "yield" ";" => Statement::new_yield(),
    "break" ";" => Statement::new_break(),
    "sleep" <Expr> ";" => Statement::new_sleep(<>),
    "const" <Identifier> "=" <ConstantExpr> ";" => Statement::new_constant(<>),
};

Device: Identifier = <r"d[0-5b]"> => <>.into();

Identifier: Identifier = <r"[a-zA-Z_][a-zA-Z0-9_]*"> => Identifier::from(<>);

ConstantExpr: Value = {
    IntNum => Value::Integer(<>),
    FloatNum => Value::Float(<>),
    BoolLiteral => Value::Boolean(<>),
};

// Expression precedence (lowest to highest):
//   Ternary (? :)
//   Disjunction (||)
//   Conjunction (&&)
//   BitOr (|)
//   BitXor (^)
//   BitAnd (&)
//   Comparison (== != < > <= >=)
//   Shift (<< >>)
//   Summ (+ -)
//   Factor (* / %)
//   Power (**)
//   Unary (! ~)
//   Term (literals, identifiers, calls, parenthesized)

pub Expr: Box<Expr> = Ternary;

Ternary: Box<Expr> = {
    <Disjunction> "?" <Ternary> ":" <Ternary> => Box::new(Expr::Ternary(<>)),
    Disjunction,
};

Disjunction: Box<Expr> = {
    Disjunction DisjOp Conjunction => Box::new(Expr::BinaryOp(<>)),
    Conjunction,
};

DisjOp: BinaryOpcode = {
    "||" => BinaryOpcode::Disj,
};

Conjunction: Box<Expr> = {
    Conjunction ConjOp BitOrExpr => Box::new(Expr::BinaryOp(<>)),
    BitOrExpr,
};

ConjOp: BinaryOpcode = {
    "&&" => BinaryOpcode::Conj,
};

BitOrExpr: Box<Expr> = {
    BitOrExpr BitOrOp BitXorExpr => Box::new(Expr::BinaryOp(<>)),
    BitXorExpr,
};

BitOrOp: BinaryOpcode = "|" => BinaryOpcode::BitOr;

BitXorExpr: Box<Expr> = {
    BitXorExpr BitXorOp BitAndExpr => Box::new(Expr::BinaryOp(<>)),
    BitAndExpr,
};

BitXorOp: BinaryOpcode = "^" => BinaryOpcode::BitXor;

BitAndExpr: Box<Expr> = {
    BitAndExpr BitAndOp Comparison => Box::new(Expr::BinaryOp(<>)),
    Comparison,
};

BitAndOp: BinaryOpcode = "&" => BinaryOpcode::BitAnd;

Comparison: Box<Expr> = {
    ShiftExpr CompareOp ShiftExpr => Box::new(Expr::BinaryOp(<>)),
    ShiftExpr,
};

CompareOp: BinaryOpcode = {
    "==" => BinaryOpcode::Equals,
    "!=" => BinaryOpcode::NotEquals,
    "<" => BinaryOpcode::Lower,
    ">" => BinaryOpcode::Greater,
    "<=" => BinaryOpcode::LowerEquals,
    ">=" => BinaryOpcode::GreaterEquals,
};

ShiftExpr: Box<Expr> = {
    ShiftExpr ShiftOp Summ => Box::new(Expr::BinaryOp(<>)),
    Summ,
};

ShiftOp: BinaryOpcode = {
    "<<" => BinaryOpcode::ShiftLeft,
    ">>" => BinaryOpcode::ShiftRight,
};

Summ: Box<Expr> = {
    Summ SummOp Factor => Box::new(Expr::BinaryOp(<>)),
    Factor,
};

SummOp: BinaryOpcode = {
    "+" => BinaryOpcode::Add,
    "-" => BinaryOpcode::Sub,
};

Factor: Box<Expr> = {
    Factor FactorOp Power => Box::new(Expr::BinaryOp(<>)),
    Power,
};

FactorOp: BinaryOpcode = {
    "*" => BinaryOpcode::Mul,
    "/" => BinaryOpcode::Div,
    "%" => BinaryOpcode::Mod,
};

// Right-associative: a ** b ** c = a ** (b ** c)
Power: Box<Expr> = {
    <l:UnaryResult> "**" <r:Power> => Box::new(Expr::BinaryOp(l, BinaryOpcode::Pow, r)),
    UnaryResult,
};

UnaryResult: Box<Expr> = {
    "!" <Term> => Box::new(Expr::UnaryOp(UnaryOpcode::Not, <>)),
    "~" <Term> => Box::new(Expr::UnaryOp(UnaryOpcode::BitNot, <>)),
    Term,
};

IntNum: i64 = r"-?[0-9]+" => i64::from_str(<>).expect("failed to parse int");
FloatNum: f64 = r"-?[0-9]+\.[0-9]+" => f64::from_str(<>).expect("failed to parse float");
BoolLiteral: bool = {
    "true" => true,
    "false" => false,
};

Term: Box<Expr> = {
    ConstantExpr => Box::new(Expr::Constant(<>)),
    <Identifier> "(" <Args> ")" => Box::new(Expr::Call(<>)),
    Identifier => Box::new(Expr::Identifier(<>)),
    "(" <Expr> ")",
};

Block: Block = {
    "{" <Statements?> "}" => Block::new_statements(<>),
};

Params = Comma<Identifier>;
Args = Comma<Expr>;

Sep<E,S>: Vec<E> =
    <v0:(<E> S)*> <e1:E?> =>
        v0.into_iter().chain(e1).collect();

Comma<E>: Vec<E> = Sep<E, ",">;

IfStatement: IfStatement = {
    "if" <Expr> <Block> "else" <Block> => IfStatement::new_if_else(<>),
    "if" <Expr> <Block> => IfStatement::new_if(<>),
};

DeviceStatement: DeviceStatement = {
    "read" <DeviceExpr> "." <Identifier> "into" <Identifier> => DeviceStatement::new_read(<>),
    "write" <Expr> "into" <DeviceExpr> "." <Identifier> => DeviceStatement::new_write(<>),
    "slot" "read" <DeviceExpr> "[" <Expr> "]" "." <Identifier> "into" <Identifier> => DeviceStatement::new_slot_read(<>),
    "slot" "write" <Expr> "into" <DeviceExpr> "[" <Expr> "]" "." <Identifier> => DeviceStatement::new_slot_write(<>),
    "batch" "read" <Expr> "." <Identifier> <Identifier> "into" <Identifier> => DeviceStatement::new_batch_read(<>),
    "batch" "write" <Expr> "into" <Expr> "." <Identifier> => DeviceStatement::new_batch_write(<>),
};

// Device expression: an identifier or parenthesized expression before ".Property"
// Kept simple to avoid ambiguity with the full Expr grammar and "."
DeviceExpr: Box<Expr> = {
    Identifier => Box::new(Expr::Identifier(<>)),
    Device => Box::new(Expr::Identifier(<>)),
    "(" <Expr> ")",
};
